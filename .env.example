# =============================================================================
# Container Registry & Image Settings
# =============================================================================
# Replace with your GitHub username or organization in lowercase
REGISTRY=ghcr.io/technicaldebtanalytics
TAG=latest

# Image Names
FRONTEND_IMAGE=debtlens-frontend
MAIN_BACKEND_IMAGE=debtlens-main-backend
ANALYSIS_IMAGE=debtlens-analysis-service
ML_IMAGE=debtlens-ml-service

# Host Port Mappings
FRONTEND_PORT=80
MAIN_BACKEND_PORT=8080
ANALYSIS_PORT=8082
ML_PORT=8000

# =============================================================================
# Database Configuration (Neon PostgreSQL)
# =============================================================================
DB_URL=jdbc:postgresql://your-neon-host.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
JPA_SHOW_SQL=false

# =============================================================================
# Message Broker Configuration (CloudAMQP / RabbitMQ)
# =============================================================================
RABBITMQ_HOST=your-rabbitmq-host.cloudamqp.com
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=your_rabbitmq_username
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_VHOST=your_rabbitmq_vhost
RABBITMQ_SSL_ENABLED=false

# RabbitMQ Queues
ANALYSIS_JOB_QUEUE=analysis_job_creation.queue
ANALYSIS_RESULT_QUEUE=analysis_job_results.queue
ML_JOB_QUEUE=ML_job_cretion.queue
ML_RESULT_QUEUE=ML_job_results.queue

# =============================================================================
# Auth0 Configuration
# =============================================================================
AUTH0_DOMAIN=your-auth0-domain.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret
AUTH0_AUDIENCE=https://your-auth0-domain.auth0.com/api/v2/
AUTH0_ROLE_SYSTEM_USER=rol_your_role_id

# =============================================================================
# Application Settings & Mail SMTP
# =============================================================================
INVITATION_FRONTEND_URL=https://debtlens.mrt.lk/invitation/accept
ANALYSIS_SERVICE_HEALTH_URL=http://analysis-service:8082/actuator/health
ML_SERVICE_HEALTH_URL=http://ml-service:8000/health
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password

# Optional GitHub Personal Access Token for GitHub API rate limits
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
